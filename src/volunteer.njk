---
layout: base.njk
title: Volunteer
permalink: /volunteer/
summary: Upcoming volunteer shifts with Team Taryn — canvassing, phone banks, petitions, and events.
---
{% set shifts = collections.events | onVolunteerPage | upcoming %}
<section class="page-head vol-head">
  <div class="wrap vol-head-inner">
    <div>
      <h1>{{ volunteer.heading }}</h1>
      <p class="lede">{{ volunteer.intro }}</p>
      <div class="hero-btns">
        <a class="btn btn-gold" href="#shifts">See upcoming shifts</a>
        <button class="btn btn-ghost" type="button" data-share>Share this page</button>
      </div>
      <p class="share-msg" role="status" aria-live="polite"></p>
    </div>
    <img class="ev-head-photo" src="{{ volunteer.photo }}" alt="Team Taryn supporters at the campaign kickoff" loading="eager">
  </div>
</section>

<section class="section" id="shifts">
  <div class="wrap">
    <div class="section-head"><h2>{{ volunteer.shifts_heading }}</h2></div>
    <div class="ev-grid" data-hide-past>
      {% for ev in shifts %}
      <article class="ev-tile{% if not ev.data.image %} no-img{% endif %}" data-end="{{ (ev.data.end or ev.data.start) | isoDay }}">
        <a class="ev-pic" href="{{ ev.url }}" tabindex="-1" aria-hidden="true"{% if ev.data.image %} style="--img: url('{{ ev.data.image }}')"{% endif %}>
          {% if ev.data.image %}<img src="{{ ev.data.image }}" alt="" loading="lazy">{% else %}<span class="ev-pic-blank"><strong>{{ ev.data.start | eventDate }}</strong>{{ ev.data.start | eventMonth }}</span>{% endif %}
        </a>
        <div class="ev-body">
          <p class="ev-cat">{{ ev.data.start | eventDay }}</p>
          <h3><a href="{{ ev.url }}">{{ ev.data.title }}</a></h3>
          <p class="ev-meta">{{ ev.data.start | eventTime(ev.data.end) }}{% if ev.data.location %}<br>{{ ev.data.location }}{% endif %}</p>
          {% if ev.data.rsvp_link %}<a class="btn btn-small" href="{{ ev.data.rsvp_link }}" target="_blank" rel="noopener">Sign up for this shift</a>
          {% else %}<a class="btn btn-small" href="#signup" data-shift="{{ ev.data.title }} ({{ ev.data.start | eventDay }})">Sign up for this shift</a>{% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
    <div class="ev-empty"{% if shifts.length %} hidden{% endif %}>
      <div>
        <h3>{{ volunteer.no_shifts_heading }}</h3>
        <p>{{ volunteer.no_shifts_text }}</p>
      </div>
      <a class="btn btn-plum" href="#signup">Join the volunteer list</a>
    </div>
  </div>
</section>

<section class="section gi-volunteer" id="signup">
  <div class="wrap narrow">
    <div class="form-card">
      <h2>{{ volunteer.form_heading }}</h2>
      <p>{{ volunteer.form_text }}</p>
      {% include "volunteer-form.njk" %}
    </div>
  </div>
</section>
