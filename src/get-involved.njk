---
layout: base.njk
title: Get Involved
permalink: /get-involved/
---
<section class="page-head gi-head">
  <div class="wrap">
    <h1>Get involved</h1>
    <p class="lede">This campaign is powered by neighbors. Pick the way that fits you.</p>
    <div class="gi-choices">
      <a class="gi-choice" href="#volunteer"><strong>Volunteer</strong><span>Knock doors, make calls, or put up a yard sign</span></a>
      <a class="gi-choice" href="#updates"><strong>Get updates</strong><span>News and events in your inbox</span></a>
      <a class="gi-choice" href="{{ settings.donate_url }}" target="_blank" rel="noopener"><strong>Donate</strong><span>Any amount helps reach more voters</span></a>
      <a class="gi-choice" href="#volunteer" data-pick="Host an Event"><strong>Host an event</strong><span>Bring Taryn to your neighborhood</span></a>
    </div>
  </div>
</section>

<section class="section gi-volunteer" id="volunteer">
  <div class="wrap narrow">
    <div class="form-card">
      <h2>{{ home.forms.volunteer_heading }}</h2>
      <p>Tell us a little about you and someone from Team Taryn will reach out.</p>
      {% include "volunteer-form.njk" %}
    </div>
  </div>
</section>

<section class="gi-updates" id="updates">
  <div class="wrap gi-updates-inner">
    <div>
      <h2>{{ home.forms.signup_heading }}</h2>
      <p>{{ home.forms.signup_text }}</p>
    </div>
    {% set compact = true %}{% include "signup-form.njk" %}
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2 class="gi-more-title">More ways to help</h2>
    <div class="gi-more">
      <a href="/help-put-taryn-on-the-ballot/"><strong>Sign a ballot petition</strong><span>Help put Taryn on the ballot</span></a>
      <a href="/coffee/"><strong>Come for coffee</strong><span>Meet Taryn at a Coffee &amp; Conversation</span></a>
      <a href="/internship/"><strong>Intern with us</strong><span>For college students, credit available</span></a>
      <a href="/tampa-business-survey/"><strong>Own a business?</strong><span>Take the Tampa Business Survey</span></a>
    </div>
    <p class="gi-contact" id="contact">Questions? Email <a href="mailto:{{ settings.email }}">{{ settings.email }}</a> or call {{ settings.phone }}.</p>
  </div>
</section>
