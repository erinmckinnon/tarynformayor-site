<article class="news-card" data-cat="{{ item.data.category | slugify2 }}">
  <a href="{{ item.url }}" class="news-img" tabindex="-1" aria-hidden="true">
    {% if item.data.image %}<img src="{{ item.data.image }}" alt="" loading="lazy">{% else %}<span class="news-ph"></span>{% endif %}
  </a>
  <div class="news-text">
    <p class="news-cat">{{ item.data.category }} · {{ item.data.date | longDate }}</p>
    <h3><a href="{{ item.url }}">{{ item.data.title }}</a></h3>
  </div>
</article>
