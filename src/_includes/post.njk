---
layout: base.njk
---
<article class="article">
  <header class="article-head wrap narrow">
    <p class="eyebrow"><a href="/news/">News &amp; Updates</a> · {{ category }}</p>
    <h1>{{ title }}</h1>
    <p class="meta">{{ date | longDate }}</p>
  </header>
  {% if image %}<figure class="wrap narrow article-img"><img src="{{ image }}" alt=""></figure>{% endif %}
  <div class="wrap narrow prose">
    {{ content | safe }}
    {% if external_link %}<p><a class="btn btn-plum" href="{{ external_link }}" target="_blank" rel="noopener">Read the full story</a></p>{% endif %}
  </div>
</article>
{% include "donate-band.njk" %}
