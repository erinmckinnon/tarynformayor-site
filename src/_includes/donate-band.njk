<section class="donate-band">
  <div class="wrap donate-inner">
    <div>
      <h2>{{ home.donate.heading }}</h2>
      <p>{{ home.donate.text }}</p>
      <p class="tagline">{{ home.donate.tagline }}</p>
    </div>
    <div class="amounts" role="group" aria-label="Donation amounts">
      {% for a in home.donate.amounts %}<a class="amount" href="{{ settings.donate_url }}" target="_blank" rel="noopener">{{ a }}</a>{% endfor %}
      <a class="amount other" href="{{ settings.donate_url }}" target="_blank" rel="noopener">Another amount</a>
    </div>
  </div>
</section>
