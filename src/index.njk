---
layout: base.njk
permalink: /
---
<section class="hero">
  <div class="wrap hero-inner">
    <div class="hero-text">
      <p class="eyebrow light">{{ home.hero_eyebrow }}</p>
      <h1>{{ home.hero_headline }}</h1>
      <p class="hero-name">Taryn Sabia <em>for Mayor</em></p>
      <div class="hero-btns">
        <a class="btn btn-gold" href="#connect">{{ home.hero_button_text }} →</a>
        <a class="btn btn-ghost" href="{{ settings.donate_url }}" target="_blank" rel="noopener">Donate</a>
      </div>
    </div>
    <div class="hero-img"><img src="{{ home.hero_image }}" alt="Taryn Sabia" width="798" height="1037" fetchpriority="high"></div>
  </div>
</section>

{% if home.youtube_video_id %}
<section class="section video">
  <div class="wrap narrow center">
    <p class="eyebrow">Meet Taryn</p>
    <h2>{{ home.video_heading }}</h2>
    <p class="lede">{{ home.video_text }}</p>
    <div class="embed video-embed"><iframe src="https://www.youtube-nocookie.com/embed/{{ home.youtube_video_id | youtubeId }}?rel=0" title="{{ home.video_heading }}" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>
  </div>
</section>
{% endif %}

{% include "donate-band.njk" %}

<section class="section" id="meet">
  <div class="wrap bio">
    <div class="bio-text">
      <p class="eyebrow">Meet</p>
      <h2>Taryn Sabia</h2>
      <p class="lede">{{ home.bio_intro }}</p>
      {% for s in home.bio_sections %}
      <h3>{{ s.heading }}</h3>
      <p>{{ s.text }}</p>
      {% endfor %}
    </div>
    <div class="bio-side">
      <img src="{{ home.bio_photo }}" alt="Taryn Sabia" loading="lazy">
      <blockquote>“{{ home.quote }}”</blockquote>
    </div>
  </div>
  <div class="wrap stats">
    {% for s in home.stats %}<div class="stat"><strong>{{ s.number }}</strong><span>{{ s.label }}</span></div>{% endfor %}
  </div>
</section>

<section class="mission"><div class="wrap narrow center"><p>{{ home.mission_statement }}</p></div></section>

<section class="section cream" id="issues">
  <div class="wrap">
    <p class="eyebrow">Priorities for Tampa</p>
    <h2>On the Issues</h2>
    <p class="lede">{{ home.issues_intro }}</p>
    <div class="issues">
      {% for i in issues.issues %}
      <article class="issue">
        <p class="issue-num">{{ "0" if loop.index < 10 }}{{ loop.index }} · {{ i.tag }}</p>
        <h3>{{ i.title }}</h3>
        <p>{{ i.text }}</p>
        {% if i.links and i.links.length %}<p class="issue-links">{% for l in i.links %}<a href="{{ l.url }}">{{ l.label }} ↗</a>{% endfor %}</p>{% endif %}
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section connect" id="connect">
  <div class="wrap two-col">
    <div>
      <p class="eyebrow">Get Involved</p>
      <h2>{{ home.connect_heading }}</h2>
      <p class="lede">{{ home.connect_text }}</p>
      {% set compact = false %}{% include "signup-form.njk" %}
    </div>
    <div id="volunteer">
      <p class="eyebrow">Volunteer</p>
      <h2>{{ home.volunteer_heading }}</h2>
      <p>{{ home.volunteer_text }}</p>
      {% include "volunteer-form.njk" %}
    </div>
  </div>
</section>

<section class="section cream">
  <div class="wrap">
    <div class="section-head"><h2>News &amp; Updates</h2><a href="/news/">All news →</a></div>
    <div class="news-grid">
      {% for item in collections.news | head(4) %}{% include "news-card.njk" %}{% endfor %}
    </div>
  </div>
</section>

{% set upcomingEvents = collections.events | upcoming %}
<section class="section">
  <div class="wrap">
    <div class="section-head"><h2>Upcoming Events</h2><a href="/events/">All events →</a></div>
    <p class="lede">Join Taryn at an upcoming event, volunteer opportunity, or community conversation.</p>
    <div class="event-list" data-hide-past data-limit="4">
      {% for ev in upcomingEvents | head(8) %}{% include "event-card.njk" %}{% endfor %}
    </div>
    <p class="empty-note"{% if upcomingEvents.length %} hidden{% endif %}>New events are on the way — check back soon.</p>
  </div>
</section>

<section class="closing">
  <div class="wrap narrow center">
    <p class="eyebrow light">Be part of the movement</p>
    <h2>{{ home.closing_heading }}</h2>
    <p>{{ home.closing_text }}</p>
    <a class="btn btn-gold" href="{{ settings.donate_url }}" target="_blank" rel="noopener">Contribute Now →</a>
  </div>
</section>
