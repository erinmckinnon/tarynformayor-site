---
layout: base.njk
permalink: /
---
{% set keyDates = collections.events | inCategory("Election Date") | upcoming %}
<section class="hero">
  <div class="hero-map" aria-hidden="true"></div>
  <div class="wrap hero-inner">
    <div class="hero-text">
      <p class="hero-kicker">{{ home.hero.kicker }}</p>
      <h1>{{ home.hero.headline }}</h1>
      <p class="hero-sub">{{ home.hero.summary }}</p>
      <div class="hero-btns">
        <a class="btn btn-gold" href="{{ settings.donate_url }}" target="_blank" rel="noopener">Donate</a>
        <a class="btn btn-ghost" href="#connect">{{ home.hero.button_text }}</a>
      </div>
    </div>
    <div class="hero-img"><img src="{{ home.hero.photo }}" alt="Taryn Sabia" width="798" height="1037" fetchpriority="high"></div>
  </div>
</section>
{% if keyDates.length %}
<section class="key-dates" aria-labelledby="kd-title">
  <div class="wrap kd-inner">
    <h2 id="kd-title">Key dates for voters</h2>
    <ol class="kd-list" data-hide-past>
      {% for ev in keyDates | head(3) %}
      <li class="kd" data-end="{{ (ev.data.end or ev.data.start) | isoDay }}">
        <a href="{{ ev.url }}"><span class="kd-date">{{ ev.data.start | eventMonth }} {{ ev.data.start | eventDate }}</span><span class="kd-name">{{ ev.data.title }}</span></a>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
{% endif %}

<section class="meet" id="meet">
  <div class="wrap meet-inner">
    <div class="meet-photos">
      <img class="meet-main" src="{{ home.about.photo }}" alt="Taryn Sabia" loading="lazy">
      {% if home.about.photo_2 %}<img class="meet-second" src="{{ home.about.photo_2 }}" alt="Taryn Sabia speaking at a community event" loading="lazy">{% endif %}
    </div>
    <div class="meet-text">
      <h2>Meet Taryn Sabia</h2>
      <p class="meet-intro">{{ home.about.intro }}</p>
      {% for s in home.about.sections %}
      <h3>{{ s.heading }}</h3>
      <p>{{ s.text }}</p>
      {% endfor %}
    </div>
  </div>
</section>

<section class="proof">
  <div class="wrap">
    <blockquote class="proof-quote">“{{ home.about.quote }}”</blockquote>
    <dl class="stats">
      {% for s in home.about.stats %}<div class="stat"><dt>{{ s.label }}</dt><dd>{{ s.number }}</dd></div>{% endfor %}
    </dl>
  </div>
</section>

{% include "donate-band.njk" %}

{% if home.video.youtube %}
{% set vid = home.video.youtube | youtubeId %}
<section class="video">
  <div class="wrap video-inner">
    <div class="video-copy">
      <h2>{{ home.video.heading }}</h2>
      <p>{{ home.video.text }}</p>
    </div>
    <div class="yt" data-yt="{{ vid }}">
      <img src="https://i.ytimg.com/vi/{{ vid }}/maxresdefault.jpg" alt="" loading="lazy">
      <button type="button" class="yt-play" aria-label="Play video: {{ home.video.heading }}"><svg viewBox="0 0 80 80" aria-hidden="true"><circle cx="40" cy="40" r="39" fill="#c9a54e"/><path d="M33 26l22 14-22 14z" fill="#23142b"/></svg></button>
    </div>
  </div>
</section>
{% endif %}

<section class="issues-sec" id="issues">
  <div class="wrap">
    <div class="issues-head">
      <h2>On the issues</h2>
      <p>{{ home.issues.intro }}</p>
    </div>
    <div class="issue-tabs" data-tabs>
      <div class="tab-list" role="tablist" aria-label="Issues">
        {% for i in home.issues.list %}
        <button role="tab" id="tab-{{ loop.index }}" aria-controls="panel-{{ loop.index }}" aria-selected="{{ 'true' if loop.first else 'false' }}" tabindex="{{ '0' if loop.first else '-1' }}">{{ i.tag }}</button>
        {% endfor %}
      </div>
      {% for i in home.issues.list %}
      <div class="tab-panel" role="tabpanel" id="panel-{{ loop.index }}" aria-labelledby="tab-{{ loop.index }}"{% if not loop.first %} hidden{% endif %}>
        <p class="panel-tag">{{ i.tag }}</p>
        <h3>{{ i.title }}</h3>
        <p>{{ i.text }}</p>
        {% if i.links and i.links.length %}<ul class="issue-links">{% for l in i.links %}<li><a href="{{ l.url }}">{{ l.label }}</a></li>{% endfor %}</ul>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="community" style="--photo: url('{{ home.community.photo }}')">
  <div class="wrap community-inner">
    <h2>{{ home.community.heading }}</h2>
    <p>{{ home.community.text }}</p>
    <div class="hero-btns">
      <a class="btn btn-gold" href="#volunteer">Volunteer</a>
      <a class="btn btn-ghost" href="/events/">See upcoming events</a>
    </div>
  </div>
</section>

<section class="section connect" id="connect">
  <div class="wrap two-col">
    <div class="form-card">
      <h2>{{ home.forms.signup_heading }}</h2>
      <p>{{ home.forms.signup_text }}</p>
      {% set compact = false %}{% include "signup-form.njk" %}
    </div>
    <div class="form-card" id="volunteer">
      <h2>{{ home.forms.volunteer_heading }}</h2>
      <p>{{ home.forms.volunteer_text }}</p>
      {% include "volunteer-form.njk" %}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head"><h2>News &amp; updates</h2><a href="/news/">All news</a></div>
    <div class="news-feature">
      {% for item in collections.news | head(4) %}{% set featured = loop.first %}{% include "news-card.njk" %}{% endfor %}
    </div>
  </div>
</section>

{% set upcomingEvents = collections.events | notCategory("Election Date") | upcoming %}
<section class="section cream">
  <div class="wrap">
    <div class="section-head"><h2>Upcoming events</h2><a href="/events/">All events</a></div>
    <div class="event-list" data-hide-past data-limit="4">
      {% for ev in upcomingEvents | head(8) %}{% include "event-card.njk" %}{% endfor %}
    </div>
    <p class="empty-note"{% if upcomingEvents.length %} hidden{% endif %}>Nothing on the calendar right now. <a href="#connect">Sign up for updates</a> and we’ll tell you when the next event is set.</p>
  </div>
</section>
