---
layout: base.njk
permalink: /
---
{% set keyDates = collections.events | inCategory("Election Date") | upcoming %}
<section class="hero">
  <div class="wrap hero-inner">
    <div class="hero-text">
      <p class="hero-kicker">{{ home.hero_eyebrow }}</p>
      <h1>{{ home.hero_headline }}</h1>
      <p class="hero-sub">{{ home.mission_statement }}</p>
      <div class="hero-btns">
        <a class="btn btn-gold" href="#connect">{{ home.hero_button_text }}</a>
        <a class="btn btn-ghost" href="{{ settings.donate_url }}" target="_blank" rel="noopener">Donate</a>
      </div>
    </div>
    <div class="hero-img"><img src="{{ home.hero_image }}" alt="Taryn Sabia" width="798" height="1037" fetchpriority="high"></div>
  </div>
</section>
{% if keyDates.length %}
<section class="key-dates" aria-labelledby="kd-title">
  <div class="wrap kd-inner">
    <h2 id="kd-title">Key dates for voters</h2>
    <ol class="kd-list" data-hide-past>
      {% for ev in keyDates | head(3) %}
      <li class="kd" data-end="{{ (ev.data.end or ev.data.start) | isoDay }}">
        <a href="{{ ev.url }}"><span class="kd-date">{{ ev.data.start | eventMonth }} {{ ev.data.start | eventDate }}</span><span class="kd-name">{{ ev.data.title }}</span></a>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
{% endif %}

{% if home.youtube_video_id %}
{% set vid = home.youtube_video_id | youtubeId %}
<section class="section video">
  <div class="wrap video-inner">
    <div class="video-copy">
      <h2>{{ home.video_heading }}</h2>
      <p class="lede">{{ home.video_text }}</p>
    </div>
    <div class="yt" data-yt="{{ vid }}">
      <img src="https://i.ytimg.com/vi/{{ vid }}/maxresdefault.jpg" alt="" loading="lazy">
      <button type="button" class="yt-play" aria-label="Play video: {{ home.video_heading }}"><svg viewBox="0 0 68 48" aria-hidden="true"><path d="M66.5 7.7A8.5 8.5 0 0 0 60.5 1.7C55.2.3 34 .3 34 .3s-21.2 0-26.5 1.4A8.5 8.5 0 0 0 1.5 7.7C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.5 8.5 0 0 0 6 6C12.8 47.7 34 47.7 34 47.7s21.2 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3z" fill="#4b2c5e"/><path d="M45 24 27 14v20z" fill="#fff"/></svg></button>
    </div>
  </div>
</section>
{% endif %}

{% include "donate-band.njk" %}

<section class="section" id="meet">
  <div class="wrap bio">
    <div class="bio-text">
      <h2>Meet Taryn Sabia</h2>
      <p class="lede">{{ home.bio_intro }}</p>
      {% for s in home.bio_sections %}
      <h3>{{ s.heading }}</h3>
      <p>{{ s.text }}</p>
      {% endfor %}
    </div>
    <div class="bio-side">
      <img src="{{ home.bio_photo }}" alt="Taryn Sabia" loading="lazy">
      <blockquote>“{{ home.quote }}”</blockquote>
    </div>
  </div>
  <div class="wrap stats">
    {% for s in home.stats %}<div class="stat"><strong>{{ s.number }}</strong><span>{{ s.label }}</span></div>{% endfor %}
  </div>
</section>

<section class="section cream" id="issues">
  <div class="wrap">
    <div class="issues-head">
      <h2>On the issues</h2>
      <p class="lede">{{ home.issues_intro }}</p>
    </div>
    <div class="issues">
      {% for i in issues.issues %}
      <article class="issue">
        <h3 class="issue-tag">{{ i.tag }}</h3>
        <div class="issue-body">
          <p class="issue-title">{{ i.title }}</p>
          <p>{{ i.text }}</p>
          {% if i.links and i.links.length %}<ul class="issue-links">{% for l in i.links %}<li><a href="{{ l.url }}">{{ l.label }}</a></li>{% endfor %}</ul>{% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section connect" id="connect">
  <div class="wrap two-col">
    <div>
      <h2>{{ home.connect_heading }}</h2>
      <p class="lede">{{ home.connect_text }}</p>
      {% set compact = false %}{% include "signup-form.njk" %}
    </div>
    <div id="volunteer">
      <h2>{{ home.volunteer_heading }}</h2>
      <p>{{ home.volunteer_text }}</p>
      {% include "volunteer-form.njk" %}
    </div>
  </div>
</section>

<section class="section cream">
  <div class="wrap">
    <div class="section-head"><h2>News &amp; updates</h2><a href="/news/">All news</a></div>
    <div class="news-feature">
      {% for item in collections.news | head(4) %}{% set featured = loop.first %}{% include "news-card.njk" %}{% endfor %}
    </div>
  </div>
</section>

{% set upcomingEvents = collections.events | notCategory("Election Date") | upcoming %}
<section class="section">
  <div class="wrap">
    <div class="section-head"><h2>Upcoming events</h2><a href="/events/">All events</a></div>
    <p class="lede">Join Taryn at an upcoming event, volunteer opportunity, or community conversation.</p>
    <div class="event-list" data-hide-past data-limit="4">
      {% for ev in upcomingEvents | head(8) %}{% include "event-card.njk" %}{% endfor %}
    </div>
    <p class="empty-note"{% if upcomingEvents.length %} hidden{% endif %}>Nothing on the calendar right now. <a href="#connect">Sign up for updates</a> and we’ll tell you when the next event is set.</p>
  </div>
</section>

<section class="closing">
  <div class="wrap narrow center">
    <h2>{{ home.closing_heading }}</h2>
    <p>{{ home.closing_text }}</p>
    <a class="btn btn-gold" href="{{ settings.donate_url }}" target="_blank" rel="noopener">Contribute now</a>
  </div>
</section>
